# Todas estas variables se cargan en Coolify. Ninguna va al repositorio.

DATABASE_URL=postgresql://usuario:clave@localhost:5432/clutch
AUTH_SECRET=
AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Discord: login principal y bot de la comunidad.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CANAL_TORNEOS=

# Epic Account Services: identidad y anti-smurf. Nunca usuario/contraseña.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# Stats de Fortnite (APIs no oficiales). Primario y fallback.
FORTNITE_API_KEY=
FORTNITE_API_IO_KEY=

# Clave AES-256 en base64 (32 bytes): openssl rand -base64 32
PRIZE_ENCRYPTION_KEY=

# Transbank Webpay Plus (fase 2).
TBK_COMMERCE_CODE=
TBK_API_KEY=
TBK_AMBIENTE=integracion

# Solo UNA réplica puede tener esto en true: de lo contrario el bot se
# conecta dos veces y los jobs se procesan dos veces.
RUN_BACKGROUND=true
