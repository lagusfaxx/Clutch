# Plantilla de configuración. Cópiala a .env y complétala.
#
# De dónde sacar cada una, paso a paso: docs/VARIABLES.md
# Para revisar lo que llevas:  npm run env:check
# Para generar los secretos:   npm run secretos
#
# Todas estas variables se cargan en el panel de despliegue. Ninguna va al
# repositorio.

# Con docker compose, DATABASE_URL se arma sola desde estas tres. Si usas
# una base gestionada (Coolify, Neon, etc.), borra estas y pon DATABASE_URL.
POSTGRES_USER=clutch
POSTGRES_PASSWORD=
POSTGRES_DB=clutch
PUERTO=3000

# DATABASE_URL=postgresql://clutch:clave@localhost:5432/clutch
AUTH_SECRET=
# Las dos con el MISMO protocolo y el mismo host. Para probar sin dominio,
# sslip.io resuelve cualquier IP: http://190-0-0-1.sslip.io:3000
# Si una dice https y el sitio va por HTTP, el login falla sin explicación.
AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Stats de Fortnite. fortnite-api.com es el proveedor primario y es el único
# que necesitas: pide la key gratis en su dashboard entrando con Discord.
FORTNITE_API_KEY=

# fortniteapi.io es OTRO servicio, con otra cuenta y otra key. Es solo el
# respaldo por si el primario se cae. Déjala vacía y el sistema se la salta
# sola, sin errores.
FORTNITE_API_IO_KEY=

# Clave AES-256 en base64 (32 bytes): openssl rand -base64 32
PRIZE_ENCRYPTION_KEY=

# Discord: opcional. Sirve para el bot de la comunidad (anuncios, roles por
# ranking, recordatorios de check-in) y para vincular la cuenta. El login
# principal es correo y contraseña, así que sin esto el sitio funciona igual.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CANAL_TORNEOS=

# Transbank Webpay Plus. Solo hace falta para torneos con inscripción pagada.
TBK_COMMERCE_CODE=
TBK_API_KEY=
TBK_AMBIENTE=integracion

# Solo UNA réplica puede tener esto en true: de lo contrario el bot de
# Discord se conecta dos veces y los jobs se procesan dos veces.
RUN_BACKGROUND=true
