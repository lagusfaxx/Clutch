{
  "name": "clutch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "check:ai-smell": "bash scripts/check-ai-smell.sh",
    "test:humo": "tsx scripts/humo.ts",
    "env:check": "tsx scripts/revisar-env.ts",
    "secretos": "node -e \"const c=require('node:crypto');console.log('AUTH_SECRET='+c.randomBytes(32).toString('base64'));console.log('PRIZE_ENCRYPTION_KEY='+c.randomBytes(32).toString('base64'));console.log('POSTGRES_PASSWORD='+c.randomBytes(24).toString('hex'))\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.2.1",
    "discord.js": "^14.16.3",
    "lru-cache": "^11.0.2",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "pg-boss": "^10.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "transbank-sdk": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
